{
  "name": "obsidian-questlog",
  "version": "2.3.0",
  "description": "Focus on one task, measure your time, keep a done list, and reflect weekly — quests in plain Markdown.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "install:vault": "node scripts/install-vault.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "obsidian",
    "focus",
    "time-tracking",
    "review",
    "productivity"
  ],
  "author": "Gian Luca Hertel",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "globals": "^17.14.0",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2.1.9"
  }
}
